generator client {
    provider = "prisma-client-js"
    output   = "../client/auth"
}

datasource db {
    provider = "postgresql"
    url      = env("AUTH_DATABASE_URL")
}

model Roles {
    role_id     Int     @id @default(autoincrement())
    role        String  @unique
    description String? @db.VarChar(255)
    users       Users[] @relation("RoleOfUser")
}

model Users {
    username       String  @unique
    password       String
    enabled        Boolean @default(true)
    verified       Boolean @default(false)
    registry_token String?
    roles          Roles[] @relation("RoleOfUser")

    publisher    Publishers? @relation(fields: [publisher_id], references: [publisher_id])
    publisher_id String      @id @unique @db.Uuid
}

model Publishers {
    publisher_id                  String                 @id @default(uuid()) @db.Uuid
    is_householder                Boolean                @default(false)
    first_name                    String                 @db.VarChar(25)
    middle_name                   String?                @db.VarChar(25)
    fathers_surname               String                 @db.VarChar(25)
    mothers_surname               String?                @db.VarChar(25)
    number_portal                 String?                @db.VarChar(10)
    sector_address                String?                @db.VarChar(25)
    street_avenue                 String?                @db.VarChar(100)
    city_municipality             String?                @db.VarChar(50)
    postal_code                   String?                @db.VarChar(5)
    floor_apartment               String?                @db.VarChar(10)
    reference_point               String?                @db.VarChar(255)
    email                         String?                @unique
    photo_url                     String?                @db.VarChar(255)
    hope                          Hope                   @default(OTHER_SHEEP)
    birth_date                    DateTime               @db.Date
    baptism_date                  DateTime?              @db.Date
    last_reporter                 DateTime?              @db.Date
    last_irregular_without_report DateTime?              @db.Date
    is_active                     Boolean                @default(true)
    is_removed                    Boolean                @default(false)
    sex                           Sex
    privileges                    PrivilegesOfPublisher[]
    phones                        Phones[]               @relation("PhoneOfPublisher")
    availability                  Availability[]

    family_group         FamilyGroups?      @relation(fields: [family_group_id], references: [family_group_id])
    family_group_id      Int?
    service_group        ServiceGroups?     @relation(fields: [service_group_id], references: [service_group_id])
    service_group_id     Int?
    emergency_contact    EmergencyContacts? @relation(fields: [emergency_contact_id], references: [emergency_contact_id])
    emergency_contact_id Int?
    user                 Users?
}

model Privileges {
    privileges_id Int                    @id @default(autoincrement())
    type          String                 @unique @db.VarChar(19)
    code          String?                @unique
    init_date     DateTime?              @db.Date
    publishers    PrivilegesOfPublisher[]
}

model PrivilegesOfPublisher {
    publisher    Publishers @relation(fields: [publisher_id], references: [publisher_id])
    publisher_id String @db.Uuid
    privilege    Privileges @relation(fields: [privilege_id], references: [privileges_id])
    privilege_id Int

    @@id([publisher_id, privilege_id])
}

model FamilyGroups {
    family_group_id Int          @id @default(autoincrement())
    name            String       @db.VarChar(50)
    publishers      Publishers[]
}

model ServiceGroups {
    service_group_id Int          @id @default(autoincrement())
    manager          String       @db.Uuid
    assistant        String       @db.Uuid
    publishers       Publishers[]

    @@unique([manager, assistant])
}

model EmergencyContacts {
    emergency_contact_id Int          @id @default(autoincrement())
    full_name            String       @db.VarChar(150)
    phone                String       @unique @db.VarChar(7)
    relationship         String       @db.VarChar(50)
    publisher            Publishers[]
}

model Phones {
    phone_id     Int          @id @default(autoincrement())
    label        String       @db.VarChar(50)
    has_whatsapp Boolean      @default(false)
    phone        String       @unique @db.VarChar(7)
    publisher    Publishers[] @relation("PhoneOfPublisher")
}

model Availability {
    availability_id Int         @id @default(autoincrement())
    start_date      DateTime?   @db.Timestamptz()
    finish_date     DateTime?   @db.Timestamptz()
    frequency       Frequency  @default(DAILY)
    days_of_week    DayOfWeek[]
    notes           String?     @db.VarChar(255)

    publisher            Publishers        @relation(fields: [publisher_id], references: [publisher_id])
    publisher_id         String            @db.Uuid
    availability         AvailabilityTypes @relation(fields: [availability_type_id], references: [availability_type_id])
    availability_type_id Int
}

model AvailabilityTypes {
    availability_type_id Int              @id @default(autoincrement())
    type                 AvailabilityType @default(AVAILABLE)
    name                 String           @unique @db.VarChar(20)
    description          String?          @db.VarChar(255)
    availabilities       Availability[]
}

enum Hope {
    OTHER_SHEEP
    ANOINTED
}

enum Frequency {
    DAILY
    WEEKLY
    MONTHLY
    ANNUALLY
    ONE_TIME
}

enum DayOfWeek {
    SUNDAY
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY
    SATURDAY
}

enum AvailabilityType {
    ABSENCE
    AVAILABLE
}

enum Sex {
    MALE
    FEMALE
}
